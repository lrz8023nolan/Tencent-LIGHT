# ============================================
# 智能长者个案管理系统 - 环境变量配置
# ============================================
# 使用说明：将此文件重命名为 .env 并填入真实值

# 服务器端口
PORT=3001

# LLM API Key（必填 - 用于 OCR 后结构化信息抽取）
LLM_API_KEY=your_api_key_here

# LLM API 端点（默认 OpenAI 兼容接口）
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# LLM 模型名称
LLM_MODEL=gpt-4o

# 数据库路径（SQLite）
DB_PATH=./db/elder_care.db

# 文件上传目录
UPLOAD_DIR=./uploads

# JSON 规则库目录
RULES_DIR=./rules
